# -*- Mode: python; c-basic-offset: 4; indent-tabs-mode: nil; tab-width: 40 -*-
# vim: set filetype=python:

SharedLibrary('hotlist')

SOURCES += [
  '../../shared/qsort.cpp',
  '../../shared/stristr.cpp',
  '../../shared/Utils.cpp',
  '../rebar_menu/hot_tracking.cpp',
  'op_edit.cpp',
  'op_file.cpp',
  'op_plugin.cpp',
  'op_utils.cpp',
]

DISABLE_STL_WRAPPING = True

RCINCLUDE = 'op_hotlist.rc'

OS_LIBS += [
  'comctl32',
  'comdlg32',
]

LOCAL_INCLUDES += [
  '../../shared'
]