# -*- Mode: python; c-basic-offset: 4; indent-tabs-mode: nil; tab-width: 40 -*-
# vim: set filetype=python:

SharedLibrary('bmpmenu')

SOURCES += [
  '../../shared/Utils.cpp',
  'bmp_menu.cpp',
  'StdAfx.cpp',
]

DEFINES['UNICODE'] = True

DEFINES['_UNICODE'] = True
DEFINES['_AFXDLL'] = True

DISABLE_STL_WRAPPING = True

OS_LIBS += ['shell32']

LOCAL_INCLUDES += [
  '../../shared'
]