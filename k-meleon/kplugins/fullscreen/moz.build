# -*- Mode: python; c-basic-offset: 4; indent-tabs-mode: nil; tab-width: 40 -*-
# vim: set filetype=python:

SharedLibrary('fullscreen')

SOURCES += [
  '../../shared/Utils.cpp',
  'fullscreen.cpp',
  'mozilla.cpp',  
]

DEFINES['UNICODE'] = True

DEFINES['_UNICODE'] = True

DISABLE_STL_WRAPPING = True

OS_LIBS += [
  'shell32',
  'xpcomglue_s',
  'xul',
]

USE_LIBS += [
  'mozalloc',
]

LOCAL_INCLUDES += [
  '../../shared'
]
	
RCINCLUDE = 'fullscreen.rc'