if not CONFIG['LIBXUL_SDK']:
    app_libxul_dirs = []
    app_libxul_static_dirs = []
    include('/toolkit/toolkit.mozbuild')

if CONFIG['MOZ_BRANDING_DIRECTORY']:
    DIRS += ['/%s' % CONFIG['MOZ_BRANDING_DIRECTORY']]

if CONFIG['MOZ_WEBAPP_RUNTIME']:
    DIRS += ['/webapprt']

# Keep application directories at the end so they are packaged correctly on Mac.
DIRS += ['/kmeleon']
